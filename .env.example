# --- LLM (NVIDIA NIM, replaces Ollama + OpenAI) ---
# Get a key at https://build.nvidia.com (starts with nvapi-)
NVIDIA_API_KEY=your_nvidia_api_key
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_NAME=nvidia/nemotron-3-super-120b-a12b
SMALL_MODEL=nvidia/nemotron-3-super-120b-a12b
EMBEDDER_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_DIM=2048

# --- Linkup web search ---
# Get a key at https://www.linkup.so/
LINKUP_API_KEY=your_linkup_api_key

# --- Neo4j (memory graph storage) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=demodemo

# --- Graphiti memory tuning (NVIDIA free tier has low rate limits) ---
SEMAPHORE_LIMIT=2

# --- Opik observability (optional, set to true to enable) ---
OPIK_ENABLED=false
